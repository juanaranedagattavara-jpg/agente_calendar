# Copy to .env and fill in your values

# PostgreSQL connection (same DB that n8n uses for Postgres Chat Memory)
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# Secret key — the dashboard HTML must send this in X-API-Key header
API_KEY=change_me_to_a_random_secret_32chars

# Port to listen on
PORT=3001

# Restrict CORS to your Chatwoot domain in production
# Example: https://chat.juanaranedag.com
# Leave empty or * to allow all origins (fine for local dev)
ALLOWED_ORIGIN=https://chat.juanaranedag.com
